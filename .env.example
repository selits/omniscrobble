# Trakt API Application Credentials
# Create yours at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here

# Media Server Ingestion Enablement (Optional)
# All media server listeners are disabled by default on clean installations.
# Enable via .env or toggle directly on the dashboard without restarting.
PLEX_ENABLED=false
JELLYFIN_ENABLED=false
EMBY_ENABLED=false

# Optional: comma-separated list of Plex usernames to scrobble (leave empty to allow all users)
PLEX_ALLOWED_USERS=

# Security & Dashboard Admin
# Optional: Secret token to protect your webhook endpoint and unlock admin dashboard features
# (e.g. /webhook?token=my_secret_token)
WEBHOOK_SECRET=

# Scrobbler Settings
# "scrobble" (real-time play/pause/stop updates + mark watched) or "watched_only" (only marks as watched on threshold finish)
SCROBBLE_MODE=scrobble
# Granular thresholds: TV episodes credit-skipping (default 80%) vs. Movies completion (default 90%)
EPISODE_SCROBBLE_THRESHOLD=80.0
MOVIE_SCROBBLE_THRESHOLD=90.0
# Backward-compatibility fallback if EPISODE/MOVIE thresholds are unset
SCROBBLE_THRESHOLD=80.0
# Maximum activity history events retained in memory and persisted to data/events.json
MAX_EVENT_HISTORY=100

# Trakt Collection Sync (library.new events)
# Automatically adds newly downloaded/added movies and episodes to Trakt collection with format specs
SYNC_COLLECTION=true
NOTIFY_ON_COLLECTION=true

# Library Section Filtering & Rules (Optional)
# ALLOWED_LIBRARIES: Only scrobble from these library section names (e.g. Movies, TV Shows)
# EXCLUDED_LIBRARIES: Never scrobble from these library section names (e.g. Home Videos, Workouts)
ALLOWED_LIBRARIES=
EXCLUDED_LIBRARIES=Home Videos, Personal Videos, Fitness
# MIN_DURATION_SECONDS: Minimum playback duration in seconds required to scrobble (default 300s = 5m)
MIN_DURATION_SECONDS=300
# APPLY_MIN_DURATION_TO_EPISODES: Whether minimum duration filter applies to episodes in addition to movies
APPLY_MIN_DURATION_TO_EPISODES=false
# IGNORED_PATH_PATTERNS: Comma-separated regex patterns to filter by media file path (e.g. /extras/, \.sample\.)
IGNORED_PATH_PATTERNS=/extras/, \.sample\.

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEBUG=false
TRAKT_TOKENS_FILE=trakt_tokens.json

# Offline Retry Queue
QUEUE_DB_FILE=data/queue.db
QUEUE_RETRY_INTERVAL=300

# Homelab & Prometheus Metrics
PROMETHEUS_METRICS_ENABLED=true

# Notifications (Optional)
# Send real-time rich embeds to Discord, messages to Telegram, and push alerts to Ntfy or Pushover
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NTFY_PRIORITY=default
NTFY_AUTH_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_PRIORITY=0
NOTIFY_ON_SCROBBLE=true
NOTIFY_ON_RATE=true
NOTIFY_ON_FAILURE=true

# Multi-User & Co-Watching ("Watch Together") (Optional)
# Automatically sync finished episodes/movies to a partner or roommate's Trakt account
CO_WATCH_USER=
CO_WATCH_SHOWS=The Bear, Severance, House of the Dragon, Succession
CO_WATCH_PLAYERS=Living Room Apple TV, Main TV
CO_WATCH_MOVIES=false

# Sonarr & Radarr Integration (Optional)
# SONARR_URL: URL to your Sonarr instance (e.g. http://localhost:8989 or https://sonarr.yourdomain.com)
# SONARR_API_KEY: Found in Sonarr -> Settings -> General -> Security -> API Key
# Enables 1-click autocomplete when adding shows to Co-Watch and direct collection webhooks
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
# Trakt Watchlist -> Sonarr/Radarr Auto-Downloader
# Automatically monitor and grab movies/shows added to your Trakt watchlist
AUTO_ADD_FROM_WATCHLIST=false
SEARCH_ON_ADD=true
# Interval in seconds to check Trakt watchlist (0 = manual via UI only, 1800 = every 30m)
ARR_WATCHLIST_INTERVAL=0
# Optional: specify quality profile ID or root folder (defaults to first available in Sonarr/Radarr)
SONARR_QUALITY_PROFILE_ID=
SONARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER=
ARR_NOTIFY_ON_ADD=true

# Two-Way Reverse Sync & Multi-Server Reconciliation (Optional)
# Enable Omniscrobble to mark items as watched in your media server when logged on Trakt
# and reconcile rating differences between your server and Trakt.
# Note: Plex is fully tested in production. Jellyfin and Emby direct connections are community beta.
PLEX_URL=http://<your-server-ip-or-domain>:32400
PLEX_TOKEN=your_plex_token_here
# Direct Jellyfin Connection (Community Beta)
JELLYFIN_URL=
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=
# Direct Emby Connection (Community Beta)
EMBY_URL=
EMBY_TOKEN=
EMBY_USER_ID=
# Automated sync interval in seconds (0 = manual sync only, 21600 = every 6 hours)
REVERSE_SYNC_INTERVAL=0
REVERSE_SYNC_ON_STARTUP=false
REVERSE_SYNC_RATINGS=true
# Automated background cloud reconciliation and Letterboxd diary export in hours (0 = disabled)
BACKGROUND_CLOUD_SYNC_INTERVAL_HOURS=24

# Multi-Tracker Integration: Simkl (Optional)
# Scrobble simultaneously to Simkl (Movies, TV Shows, Anime) alongside Trakt
# Get your Client ID and Client Secret at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here
SIMKL_ENABLED=false

# Anime Tracking Engine: AniList & MyAnimeList (Optional)
# Automatic anime detection, AniList GraphQL resolution, and multi-tracker dispatch
ANIME_AUTO_DETECT=true
ANILIST_ENABLED=true
ANILIST_CLIENT_ID=your_anilist_client_id_here
ANILIST_CLIENT_SECRET=your_anilist_client_secret_here
MAL_ENABLED=true
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
