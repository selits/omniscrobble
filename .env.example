# Trakt API Application Credentials
# Create yours at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here

# Plex Settings
# Optional: comma-separated list of Plex usernames to scrobble (leave empty to allow all users)
PLEX_ALLOWED_USERS=

# Security
# Optional: Secret token to protect your webhook endpoint (e.g. /webhook?token=my_secret_token)
WEBHOOK_SECRET=

# Scrobbler Settings
# "scrobble" (real-time play/pause/stop updates + mark watched) or "watched_only" (only marks as watched on 90%+ finish)
SCROBBLE_MODE=scrobble
SCROBBLE_THRESHOLD=80.0

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DEBUG=false
TRAKT_TOKENS_FILE=trakt_tokens.json

# Notifications (Optional)
# Send real-time rich embeds to Discord and/or messages to Telegram
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_SCROBBLE=true
NOTIFY_ON_RATE=true
